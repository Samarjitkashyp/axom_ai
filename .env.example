# ---- Copy this file to ".env" and fill in your own values ----

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database
DB_NAME=axom_ai
DB_USER=axom_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Google Gemini API key (streaming, translation, and fallback engine)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Local LLM (Ollama) — primary engine when on; Gemini is the fallback.
# Set USE_LOCAL_LLM=False to run Gemini-only (e.g. on small cloud instances).
USE_LOCAL_LLM=True
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_NUM_PREDICT=400
OLLAMA_NUM_THREAD=4
OLLAMA_KEEP_ALIVE=2h

# Semantic search (sentence-transformers). Default is a small, fast, multilingual
# MiniLM (~120 MB on disk, ~250 MB resident, 384-dim). Swap for 'BAAI/bge-m3'
# (~2 GB, 1024-dim) if you need higher accuracy and have the RAM.
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_THRESHOLD=0.72        # min similarity to accept a knowledge-base match

# Strict knowledge mode: True = say "don't know" when the answer isn't in the KB;
# False = allow general answers (greetings, coding, etc.). Default False.
STRICT_KB_MODE=False

# IndicTrans2 (AI4Bharat) Assamese translation microservice.
# Runs in its own venv on the server (see deploy/translate_service.py +
# indictrans.service). Used for general (non-KB) Assamese answers: Gemini replies
# in English, then IndicTrans2 -> natural Assamese. Set USE_INDICTRANS=False to
# turn it off (falls back to Gemini's own Assamese).
USE_INDICTRANS=True
INDICTRANS_URL=http://127.0.0.1:8765

# Tavily — AI-optimised web search. Free tier: 1000 queries / month.
# Powers the 🌐 Web toggle in chat (Tavily results synthesised into Assamese
# by Groq). Get a free key at https://tavily.com/
TAVILY_API_KEY=
WEBSEARCH_DAILY_LIMIT=5         # per-device (per-IP) web searches per day

# Cloudflare Workers AI — free 10k neurons/day (~100+ FLUX schnell images).
# Primary engine for the "Generate Image" tool. Both vars must be set.
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Google Gemini image generation (paid — needs billing enabled on the project).
# Set USE_GEMINI_IMAGE=True to use Gemini as the primary image engine ahead of
# Cloudflare. Leave False on the free tier.
USE_GEMINI_IMAGE=False

# Groq — automatic fallback when Gemini fails (e.g. free daily quota exhausted).
# Very fast, generous free tier. Get a free key at https://console.groq.com/keys
# Used for chat answers, the IndicTrans2 English step, and Assamese baking.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Chat rate limit (per IP)
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60

# Memory management
MEMORY_CHAR_BUDGET=3500        # conversation context sent to the model
MAX_MSGS_PER_SESSION=100       # messages kept per chat
MAX_SESSIONS_PER_KEY=50        # non-pinned chats kept per browser
