# ---- Copy this file to ".env" and fill in your own values ----

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database
DB_NAME=axom_ai
DB_USER=axom_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Google Gemini API key (used for web search + as a fallback engine)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Local LLM (Ollama) — primary engine, Gemini is fallback
USE_LOCAL_LLM=True
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_NUM_PREDICT=400
OLLAMA_NUM_THREAD=4
OLLAMA_KEEP_ALIVE=2h

# Strict knowledge mode: say "don't know" instead of guessing when the answer
# is not in the knowledge base. Set to False to allow free general answers.
STRICT_KB_MODE=True

# Chat rate limit (per IP)
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW=60
