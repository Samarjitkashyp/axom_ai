<h2 id="quickstart">7. Quick Start: Python Integration</h2>
<pre><code>import torch
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# 1. Load weights from private Axom AI repository
REPO_ID = "axom-ai/axomai-trans-xetu"
token = "your_hf_access_token"

tokenizer = AutoTokenizer.from_pretrained(REPO_ID, token=token, trust_remote_code=True)
model = AutoModelForSeq2SeqLM.from_pretrained(REPO_ID, token=token, trust_remote_code=True)

# 2. Translate English to Assamese
english_text = "Welcome to Axom AI, the native artificial intelligence ecosystem of Assam."
inputs = tokenizer([english_text], src_lang="eng_Latn", tgt_lang="asm_Beng", return_tensors="pt")

with torch.no_grad():
    outputs = model.generate(**inputs, max_length=256, num_beams=4)

translation = tokenizer.batch_decode(outputs, src_lang="eng_Latn", tgt_lang="asm_Beng")[0]
print(f"Assamese Translation: {translation}")</code></pre>


