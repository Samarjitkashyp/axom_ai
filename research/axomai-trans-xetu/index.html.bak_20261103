<script type="application/ld+json">{"@context": "https://schema.org", "@type": "TechArticle", "@id": "https://aiaxom.co.in/research/axomai-trans-xetu/#article", "isPartOf": {"@type": "WebSite", "@id": "https://aiaxom.co.in/#website", "name": "Axom AI"}, "headline": "Axom AI Xetu: High-Precision English ↔ Assamese Neural Translation", "alternativeHeadline": "Axom AI Bridge - Xetu (সেতু)", "description": "Axom AI Bridge - Xetu (সেতু) is a 200M parameter sequence-to-sequence neural translation bridge for English and Assamese. Preserves complex postpositions (-লৈ, -ৰ, -ত) and legal precision.", "inLanguage": ["en-IN", "as"], "mainEntityOfPage": "https://aiaxom.co.in/research/axomai-trans-xetu/", "datePublished": "2026-11-02", "dateModified": "2026-11-02", "author": {"@type": "Person", "name": "Samarjit Kashyap", "jobTitle": "Founder & AI Architect", "url": "https://github.com/Samarjitkashyp", "worksFor": {"@type": "Organization", "name": "Axom AI", "url": "https://aiaxom.co.in"}}, "publisher": {"@type": "Organization", "name": "Axom AI", "url": "https://aiaxom.co.in", "logo": {"@type": "ImageObject", "url": "https://aiaxom.co.in/axom-browser-logo.png"}}, "speakable": {"@type": "SpeakableSpecification", "cssSelector": [".hero-c h1", ".lead", ".answer p", ".faq-body p"]}, "about": [{"@type": "Thing", "name": "Artificial Intelligence in Assam"}, {"@type": "Thing", "name": "Assamese Language Model"}, {"@type": "Thing", "name": "Axom AI"}, {"@type": "Thing", "name": "Natural Language Processing"}, {"@type": "Thing", "name": "Sovereign AI"}], "mentions": [{"@type": "Thing", "name": "OpenAI"}, {"@type": "Thing", "name": "Google Gemini"}, {"@type": "Thing", "name": "Anthropic Claude"}, {"@type": "Thing", "name": "ElevenLabs"}], "keywords": "assamese translation ai, english to assamese translation, assamese translation model, xetu translation, axom ai xetu, ai in assam, artificial intelligence in assam, assam ai, google translate assamese vs axom ai, legal translation assam, samarjit kashyap ai"}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Why is Axom AI Xetu better than Google Translate for Assamese?", "acceptedAnswer": {"@type": "Answer", "text": "Google Translate relies on generic multilingual models that frequently scramble Assamese case endings (-ৰ, -লৈ, -ত) and translate idioms literally. Axom AI Xetu is a specialized 200M Seq2Seq model trained directly on parallel Assam administrative, educational, and cultural data, ensuring grammatical fidelity."}}, {"@type": "Question", "name": "Can Axom AI Xetu be deployed completely offline?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The entire model fits into 1.03 GB of storage and operates under 850 MB of RAM, allowing government departments, legal chambers, and healthcare providers to run 100% private translations without connecting to the internet."}}, {"@type": "Question", "name": "Does Xetu support technical and legal vocabularies?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Xetu is explicitly calibrated on Assam state gazettes, legislative bills, land revenue terms, and educational texts, making it highly accurate for technical and administrative documents."}}, {"@type": "Question", "name": "Who owns the rights to Axom AI Xetu?", "acceptedAnswer": {"@type": "Answer", "text": "Axom AI Xetu is the proprietary intellectual property of Axom AI (Guwahati, Assam, India), led by Samarjit Kashyap."}}]}</script>
